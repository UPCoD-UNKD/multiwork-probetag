# Database Configuration
POSTGRES_DB=multiworkdb
POSTGRES_USER=postgres
# CHANGE THIS!
POSTGRES_PASSWORD=replace_with_strong_password

# Application Security
# CHANGE THIS! (Use a 32+ character random string)
APP_JWT_SECRET=replace_with_very_secure_secret_key_base64_encoded
APP_JWT_EXPIRATION_MS=86400000

# CORS Configuration
# Set this to your domain, e.g., http://example.com or https://myapp.com
APP_CORS_ALLOWED_ORIGINS=http://localhost
