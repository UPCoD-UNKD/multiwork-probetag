# Пример конфигурации для VS Code Remote - SSH
# Скопируйте этот файл в ~/.ssh/config (на Windows: C:\Users\YourUsername\.ssh\config)

Host azure-vm
    HostName YOUR_AZURE_VM_IP_OR_DOMAIN
    User YOUR_USERNAME
    IdentityFile ~/.ssh/id_rsa
    Port 22
    ForwardAgent yes
    
    # Опционально: автоматическое переподключение
    ServerAliveInterval 60
    ServerAliveCountMax 3

# Пример с несколькими VM
Host azure-vm-dev
    HostName dev.yourdomain.com
    User developer
    IdentityFile ~/.ssh/id_rsa_dev

Host azure-vm-prod
    HostName prod.yourdomain.com
    User admin
    IdentityFile ~/.ssh/id_rsa_prod
    Port 2222
