{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Compose Up (Production)",
      "type": "shell",
      "command": "docker-compose -f docker-compose.production.yml up -d --build",
      "options": {
        "cwd": "${workspaceFolder}/multiwork-backend"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Compose Up (Development)",
      "type": "shell",
      "command": "docker-compose up -d --build",
      "options": {
        "cwd": "${workspaceFolder}/multiwork-backend"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docker: Compose Down",
      "type": "shell",
      "command": "docker-compose down",
      "options": {
        "cwd": "${workspaceFolder}/multiwork-backend"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docker: View Logs (Backend)",
      "type": "shell",
      "command": "docker-compose logs -f backend",
      "options": {
        "cwd": "${workspaceFolder}/multiwork-backend"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Docker: Restart Backend",
      "type": "shell",
      "command": "docker-compose restart backend",
      "options": {
        "cwd": "${workspaceFolder}/multiwork-backend"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docker: Clean Up",
      "type": "shell",
      "command": "docker-compose down -v --remove-orphans",
      "options": {
        "cwd": "${workspaceFolder}/multiwork-backend"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
