# ============================================
# Multiwork Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!

# ============================================
# Database Configuration
# ============================================
# For PostgreSQL (Production/RDS/Azure):
# 
# Azure PostgreSQL example:
# SPRING_DATASOURCE_URL=jdbc:postgresql://multiwork.postgres.database.azure.com:5432/multiwork?sslmode=require
# SPRING_DATASOURCE_USERNAME=SPRING_H2@multiwork
# SPRING_DATASOURCE_PASSWORD=Multiwork@17864
#
# AWS RDS example:
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-database-host:5432/multiwork
# SPRING_DATASOURCE_USERNAME=your_database_username
# SPRING_DATASOURCE_PASSWORD=your_secure_database_password

SPRING_DATASOURCE_URL=jdbc:postgresql://your-database-host:5432/multiwork
SPRING_DATASOURCE_USERNAME=your_database_username
SPRING_DATASOURCE_PASSWORD=your_secure_database_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# For H2 (Local Development - optional, defaults are used):
# SPRING_DATASOURCE_URL=jdbc:h2:file:./data/devdb;DATABASE_TO_UPPER=false
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=

# ============================================
# JWT Configuration
# ============================================
# CRITICAL: Generate a secure secret for production!
# Generate using: openssl rand -base64 32
# The secret must be Base64 encoded and at least 256 bits (32 bytes)
APP_JWT_SECRET=your_base64_encoded_secret_key_here_minimum_32_bytes
APP_JWT_EXPIRATION_MS=86400000

# ============================================
# Server Configuration
# ============================================
SERVER_PORT=8080

# ============================================
# CORS Configuration
# ============================================
# For production, specify exact origins (comma-separated):
# APP_CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# For development:
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_CORS_ALLOWED_METHODS=*
APP_CORS_ALLOWED_HEADERS=*
APP_CORS_ALLOW_CREDENTIALS=true

# ============================================
# H2 Console (Development only)
# ============================================
# WARNING: Set to false in production!
SPRING_H2_CONSOLE_ENABLED=true

# ============================================
# JPA Configuration (Optional)
# ============================================
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
