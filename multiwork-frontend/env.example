# ============================================
# Multiwork Frontend - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!

# ============================================
# API Configuration
# ============================================
# Backend API URL
# For local development:
REACT_APP_API_URL=http://localhost:8080

# For production, set to your backend URL:
# REACT_APP_API_URL=https://api.example.com

# ============================================
# Development Server Configuration
# ============================================
# Host to bind the development server to
# Set to 0.0.0.0 to allow access from other devices on your network
# Default: localhost (only accessible from the same machine)
HOST=0.0.0.0

# Port for the development server
# Default: 3000
# PORT=3000

# ============================================
# Other Configuration (if needed)
# ============================================
# REACT_APP_ENV=development
# REACT_APP_VERSION=0.1.0
